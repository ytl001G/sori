{
  "name": "sori",
  "version": "0.4.0",
  "description": "Multitrack audio editor",
  "main": "main.js",
  "bin": {
    "sori": "src/cli/sori.js"
  },
  "scripts": {
    "start": "electron .",
    "test": "node test/standards.js && node test/run.js",
    "dist": "electron-builder --win nsis",
    "smoke": "electron . --smoke"
  },
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "acorn": "^8.19.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "@phosphor-icons/core": "^2.1.1",
    "fft.js": "^4.0.4",
    "pretendard": "^1.3.9",
    "read-excel-file": "^9.3.14",
    "soundtouchjs": "^0.3.0"
  },
  "productName": "Sori",
  "private": true,
  "build": {
    "appId": "local.sori.editor",
    "productName": "Sori",
    "files": [
      "main.js",
      "package.json",
      "LICENSE",
      "docs/cli.md",
      "THIRD_PARTY_NOTICES.md",
      "licenses/**",
      "src/**",
      "test/smoke.js",
      "test/smoke/**",
      "node_modules/**",
      "!node_modules/pretendard/dist/public/**",
      "!node_modules/pretendard/dist/web/static/**",
      "!node_modules/pretendard/dist/web/variable/woff2-dynamic-subset/**",
      "!node_modules/pretendard/docs/**",
      "!node_modules/@phosphor-icons/core/assets/{bold,duotone,fill,light,thin}/**",
      "!node_modules/@phosphor-icons/core/dist/**",
      "!**/*.map",
      "!**/*.d.ts"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "fileAssociations": [
      {
        "ext": "vproj",
        "name": "Sori Project"
      }
    ]
  }
}
